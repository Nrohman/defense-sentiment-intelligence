# Google Gemini API Key
# Dapatkan API key gratis di: https://aistudio.google.com/
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere

# Twitter / X Auth Token (Opsional, untuk scraping live via tweet-harvest)
# Didapatkan dari cookie 'auth_token' pada browser setelah login di x.com
TWITTER_AUTH_TOKEN=your_twitter_auth_token_here

# Ngrok Auth Token (Opsional, jika menjalankan via Google Colab / tunnel public)
NGROK_AUTH_TOKEN=your_ngrok_auth_token_here
